**/backups/
*.dump
*.tar.gz
*.sql.gz
*.bak
scripts/migrate/*.json
scripts/migrate/id-mapping.json
scripts/migrate/migration-log.json

# Local Databases
*.sqlite
*.sqlite3
*.db
*.rdb

