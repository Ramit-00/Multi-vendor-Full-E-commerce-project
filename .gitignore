# =======================================================
# Dependencies
# =======================================================
node_modules/
*/node_modules/
**/node_modules/

# =======================================================
# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
# =======================================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# =======================================================
# Build & Distribution Artifacts
# =======================================================
dist/
dist-ssr/
build/
*/dist/
*/build/
frontend/dist/

# =======================================================
# Logs & Debug Output
# =======================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =======================================================
# Operating System & Editor Files
# =======================================================
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =======================================================
# Temporary & Scratch Files
# =======================================================
*.tmp
*.temp
scratch/
.offline_cache.json
backend/.offline_cache.json
.cache/
.vite/
frontend/.vite/
coverage/
.eslintcache
