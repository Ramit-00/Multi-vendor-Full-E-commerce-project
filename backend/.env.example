PORT=8080
MONGO_URI=your_mongo_connection_string_here
SECERET_KEY=your_jwt_secret_here

# Payment gateways
STRIPE_SECRET_KEY=your_stripe_secret_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email settings (for production use SMTP; for Gmail use app password)
EMAIL_SERVICE=gmail
EMAIL_USER=your.email@example.com
EMAIL_PASS=your_email_app_password

# Development helpers
DEBUG_SHOW_OTP=false
ALLOW_OFFLINE=false

# Master Admin Security Settings
ADMIN_SECRET_KEY="your_admin_master_secret_key_here"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_admin_password_here"

# Google Authentication & AI
GOOGLE_CLIENT_ID="your_google_client_id_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# PostgreSQL / Supabase (Prisma Core)
DATABASE_URL="postgresql://user:password@host:5432/postgres?connection_limit=10"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
