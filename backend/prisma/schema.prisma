// ============================================================
// Prisma schema — PostgreSQL transactional core (Supabase)
// Covers only entities needing strong consistency, foreign
// keys, and transactional guarantees: identity, money,
// inventory, and their relationships.
// Flexible/read-heavy data stays in MongoDB (see Part 2 table).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app at runtime
  directUrl = env("DIRECT_URL")   // direct connection, used only for migrations
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller    Seller?
  addresses Address[]
  orders    Order[]

  @@map("users")
}

model Seller {
  id                 String   @id @default(uuid())
  userId             String   @unique
  storeName          String
  payoutAccountInfo  Json
  verificationStatus String   @default("pending")
  commissionRate     Decimal  @default(0.10) @db.Decimal(5, 4)
  createdAt          DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
  payouts    SellerPayout[]
  coupons    Coupon[]

  @@map("sellers")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Product {
  id             String        @id @default(uuid())
  sellerId       String
  categoryId     String?
  sku            String        @unique
  name           String
  price          Decimal       @db.Decimal(10, 2)
  stockQuantity  Int           @default(0)
  status         ProductStatus @default(ACTIVE)
  mongoDetailsId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seller     Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([sellerId])
  @@map("products")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  shippingAddressId String
  totalAmount       Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  shippingAddress Address     @relation(fields: [shippingAddressId], references: [id])
  orderItems      OrderItem[]
  payment         Payment?
  refunds         Refund[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  sellerId  String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  seller       Seller        @relation(fields: [sellerId], references: [id])
  sellerPayout SellerPayout?

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  paymentGateway       String
  gatewayTransactionId String?
  status               PaymentStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SellerPayout {
  id          String       @id @default(uuid())
  sellerId    String
  orderItemId String       @unique
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_payouts")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  sellerId      String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  usesLeft      Int
  expiryDate    DateTime
  createdAt     DateTime     @default(now())

  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model Refund {
  id         String       @id @default(uuid())
  orderId    String
  reason     String
  status     RefundStatus @default(REQUESTED)
  amount     Decimal      @db.Decimal(10, 2)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("refunds")
}
