{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/sellers/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/products/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/home/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/chat/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/health",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
